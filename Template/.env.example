# ===== プロジェクト固有の環境変数 =====
#
# プロジェクトに応じて以下を追加・編集してください

# 例: Next.js フロントエンド
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# 例: バックエンドAPI
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# API_SECRET_KEY=your-secret-key-here
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# 例: フルスタック
# NODE_ENV=development
# PORT=3000
# SESSION_SECRET=your-session-secret-here

# ===== Claude Code MCP Configuration =====
#
# 以下の環境変数は、ホストPCのグローバル環境変数として設定してください。
# プロジェクトの .env ではなく、~/.zshrc または ~/.bashrc に記載します。
#
# 設定例（~/.zshrc に追記）:
#
#   # Claude Code MCP Configuration
#   export GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"
#   export FIGMA_ACCESS_TOKEN="figd_xxxxxxxxxxxxxxxxxxxx"
#   export MCP_TIMEOUT=30000
#   export MAX_MCP_OUTPUT_TOKENS=25000
#   # export ENABLE_TOOL_SEARCH=auto:5
#   # export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1
#
# トークン取得先:
#   GitHub: https://github.com/settings/tokens
#   Figma:  https://www.figma.com/developers/api#access-tokens
#
# 注意: データベース接続文字列などのプロジェクト固有の機密情報のみ
#       プロジェクトの .env に設定してください。
